body {
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', sans-serif;
  background-color: #fff;
}

.container {
  position: relative;
  width: 100%;
  max-width: 1200px;
  margin: 80px auto;
  display: flex;
  justify-content: center;
  align-items: center;
}

.text-box {
  background-color: #f2f2f2;
  padding: 40px;
  width: 50%;
  box-sizing: border-box;
  z-index: 2;
  position: relative;
  box-shadow: 0px 0px 10px rgba(0,0,0,0.1);
}

.text-box h5 {
  letter-spacing: 2px;
  font-size: 14px;
  font-weight: bold;
  color: black;
  margin-bottom: 10px;
}

.text-box h1 {
  color: #0074D9;
  font-size: 32px;
  margin-bottom: 20px;
  line-height: 1.3;
}

.text-box p {
  color: #666;
  font-size: 15px;
  line-height: 1.7;
  margin-bottom: 20px;
}

.image-box {
  position: absolute;
  right: 0;
  top: -20px;
  z-index: 1;
  width: 50%;
  box-shadow: 0 10px 20px rgba(0,0,0,0.15);
}

.image-box img {
  width: 100%;
  height: auto;
  display: block;
}
